# Umami Cloud website id (Settings → Websites → Edit). Leave unset to load no analytics at all. In production it is a GitHub Actions repository variable, read by .github/workflows/pages.yml.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Lab routes. DESIGN_NEW=1 (in .env.local) builds app/new/page.lab.tsx as /new, the design experiment. Unset in CI, so it never deploys.
DESIGN_NEW=
